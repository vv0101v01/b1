///|
/// galois_rep.mbt — 31. ℓ-進表示 (ℓ-adic representations)
///
/// The Tate module representation ρ_ℓ(E): Gal(F̄_p/F_p) → GL_2(Z/ℓ)
/// acting on E[ℓ]. Computed EXPLICITLY: find a basis of E[ℓ] over F_{p^k},
/// express the Frobenius x ↦ x^p on it, verify its characteristic polynomial
/// is x² − a_p x + p (mod ℓ).
///
/// Theorem engine:
///   T31a (Tate 模特徵多項式): char poly of ρ(Frob) = x² − a_p·x + p mod ℓ
///   T31b (表示公理): ρ(Frob^n) = ρ(Frob)^n（循環群表示由生成元決定）
///   T31c (行列式/跡): det ρ(Frob) = p (mod ℓ)（= cyclotomic 特徵 mod ℓ）

///|
/// Representation matrix over Z/ℓ: 2×2 entries in [0, ℓ).
pub(all) struct Mat2(Int32, Int32, Int32, Int32)

///|
pub fn Mat2::to_string(self : Mat2) -> String {
  "[\{self.0}, \{self.1}; \{self.2}, \{self.3}]"
}

///|
/// (tr, det) mod ℓ.
pub fn Mat2::trace_mod(self : Mat2, ell : Int32) -> Int32 {
  ((self.0 + self.3) % ell + ell) % ell
}

///|
pub fn Mat2::det_mod(self : Mat2, ell : Int32) -> Int32 {
  ((self.0 * self.3 - self.1 * self.2) % ell + ell) % ell
}

///|
/// Matrix product mod ℓ.
pub fn Mat2::mul(self : Mat2, other : Mat2, ell : Int32) -> Mat2 {
  fn mm(a : Int32, b : Int32, ell_ : Int32) -> Int32 {
    (a * b % ell_ + ell_) % ell_
  }
  Mat2(
    ((mm(self.0, other.0, ell) + mm(self.1, other.2, ell)) % ell + ell) % ell,
    ((mm(self.0, other.1, ell) + mm(self.1, other.3, ell)) % ell + ell) % ell,
    ((mm(self.2, other.0, ell) + mm(self.3, other.2, ell)) % ell + ell) % ell,
    ((mm(self.2, other.1, ell) + mm(self.3, other.3, ell)) % ell + ell) % ell,
  )
}

///|
/// Find all ℓ-torsion points (P ≠ O with ℓP = O) of E over GF(p, k).
pub fn torsion_points(
  e : WCurve,
  p : Int32,
  k : Int32,
  ell : Int32,
) -> Array[ECPoint] {
  let fld = GF::make(p, k)
  let res : Array[ECPoint] = []
  for pt in e.all_points(p, k) {
    if !pt.2 {
      let q2 = e.mul(ell, pt, fld)
      if q2.2 {
        res.push(pt)
      }
    }
  }
  res
}

///|
/// Solve m·P + n·Q = R over Z/ℓ by brute force (ℓ small).
fn solve_combo(
  e : WCurve,
  fld : GF,
  p1 : ECPoint,
  p2 : ECPoint,
  r : ECPoint,
  ell : Int32,
) -> (Int32, Int32) {
  let mut m = 0
  while m < ell {
    let mut n = 0
    while n < ell {
      let mp = e.mul(m, p1, fld)
      let nq = e.mul(n, p2, fld)
      let s = e.add(mp, nq, fld)
      if s.2 == r.2 && (r.2 || (s.0 == r.0 && s.1 == r.1)) {
        return (m, n)
      }
      n = n + 1
    }
    m = m + 1
  }
  abort("solve_combo: no solution")
}

///|
/// The Frobenius matrix of ρ_ℓ(E) on E[ℓ] with basis (P, Q):
/// columns are the coordinates of Frob(P), Frob(Q).
pub fn frobenius_matrix(
  e : WCurve,
  p : Int32,
  k : Int32,
  ell : Int32,
) -> (Mat2, ECPoint, ECPoint) {
  let fld = GF::make(p, k)
  let tors = torsion_points(e, p, k, ell)
  if tors.length() < 2 {
    abort("frobenius_matrix: E[ell] not contained in E(F_{p^k})")
  }
  let pp = tors[0]
  // find Q not in <P>: check Q ∉ {O, P, 2P, ...}
  let mut qq = pp
  let mut found = false
  let mut i = 1
  while i < tors.length() && !found {
    let cand = tors[i]
    // independent iff no m with mP = cand
    let mut dep = false
    let mut m = 0
    while m < ell {
      let mp = e.mul(m, pp, fld)
      if mp.2 == cand.2 && (cand.2 || (mp.0 == cand.0 && mp.1 == cand.1)) {
        dep = true
      }
      m = m + 1
    }
    if !dep {
      qq = cand
      found = true
    }
    i = i + 1
  }
  if !found {
    abort("frobenius_matrix: basis search failed")
  }
  // Frob(x, y) = (x^p, y^p): generator of Gal(F_{p^k}/F_p)
  let frob_pp = ECPoint(fld.pow(pp.0, p), fld.pow(pp.1, p), false)
  let frob_qq = ECPoint(fld.pow(qq.0, p), fld.pow(qq.1, p), false)
  let (a, b) = solve_combo(e, fld, pp, qq, frob_pp, ell)
  let (c, d) = solve_combo(e, fld, pp, qq, frob_qq, ell)
  // columns: Frob(P) = a·P + c·Q? convention: Frob(P) = a P + b Q (row coords)
  (Mat2(a, c, b, d), pp, qq)
}

///|
/// Verify T31a: tr ≡ a_p (mod ℓ), det ≡ p (mod ℓ) for the Frobenius matrix
/// of E over F_p acting on E[ℓ]. Returns (tr_ok, det_ok, matrix).
pub fn verify_tate_module(
  e : WCurve,
  p : Int32,
  k : Int32,
  ell : Int32,
) -> (Bool, Bool, Mat2) {
  let a_p = e.trace(p)
  let (m, _, _) = frobenius_matrix(e, p, k, ell)
  let tr = m.trace_mod(ell)
  let dt = m.det_mod(ell)
  let want_tr = (a_p % ell + ell) % ell
  let want_dt = (p % ell + ell) % ell
  (tr == want_tr, dt == want_dt, m)
}

///|
/// T31b: ρ(Frob^n) = ρ(Frob)^n in GL_2(Z/ℓ) (representation of the cyclic
/// group Gal ≅ Ẑ generated by Frob). Returns max entry difference.
pub fn rep_power_consistency(
  e : WCurve,
  p : Int32,
  k : Int32,
  ell : Int32,
  n : Int32,
) -> Int32 {
  let (m, pp, qq) = frobenius_matrix(e, p, k, ell)
  // compute m^n mod ell
  let mut acc = Mat2(1, 0, 0, 1)
  let mut i = 0
  while i < n {
    acc = acc.mul(m, ell)
    i = i + 1
  }
  // Frob^n on basis: (x^{p^n}, y^{p^n})
  let fld = GF::make(p, k)
  let qn = pow_int(p, n)
  let fpp = ECPoint(fld.pow(pp.0, qn), fld.pow(pp.1, qn), false)
  let fqq = ECPoint(fld.pow(qq.0, qn), fld.pow(qq.1, qn), false)
  let (a, b) = solve_combo(e, fld, pp, qq, fpp, ell)
  let (c, d) = solve_combo(e, fld, pp, qq, fqq, ell)
  let direct = Mat2(a, c, b, d)
  // compare
  let mut err = 0
  let diffs = [
    direct.0 - acc.0,
    direct.1 - acc.1,
    direct.2 - acc.2,
    direct.3 - acc.3,
  ]
  for df in diffs {
    let ad = if df < 0 { -df } else { df }
    if ad > err {
      err = ad
    }
  }
  err
}
